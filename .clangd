# Configuration for the `clangd` language server -- https://clangd.llvm.org/config
#
# The compilation database is generated by the SCons build system into the target tree:
#     scons COMPILEDB=yes         (sticky: recorded in ./optcache)
#     scons compiledb             (one-off, compiles nothing)
# clangd does not search 'target/' on its own, hence this pointer.

CompileFlags:
  CompilationDatabase: target

